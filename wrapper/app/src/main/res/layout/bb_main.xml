<?xml version="1.0" encoding="utf-8"?>
<!--
  Design K: hero launch, scrolling tabs, full-width flag cards.

  The tab strip is a HorizontalScrollView rather than TabLayout: TabLayout lives
  in com.google.android.material, which would put AndroidX classes on this app's
  class path ahead of the archive's (see build.gradle.kts). The visual is the
  same — selected tab gets the primary colour and a 3dp underline.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bb_surface">

    <!-- Title bar. Flat: no gradient wash. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:background="@color/bb_surface">

        <TextView
            android:id="@+id/app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/bb_on_surface"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/builds_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bb_icon_button"
            android:gravity="center"
            android:text="\u2630"
            android:textColor="@color/bb_variant"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Scrolling tab strip -->
    <HorizontalScrollView
        android:id="@+id/tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bb_surface"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/tab_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bb_outline" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/flag_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="132dp" />
    </ScrollView>

    <!-- Docked launch. No notch: the override count was removed on request. -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/bb_surface"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/launch_button"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bb_launch"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="\u25B6"
                android:textColor="@color/bb_on_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/launch_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/launch"
                android:textColor="@color/bb_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
