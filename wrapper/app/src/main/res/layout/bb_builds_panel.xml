<?xml version="1.0" encoding="utf-8"?>
<!--
  The builds panel: a bottom sheet listing the installed archives, with the
  active one marked. Design C, without the size/overrides/age line.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bb_sheet"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bb_grabber" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        android:text="@string/builds"
        android:textColor="@color/bb_on_surface"
        android:textSize="19sp" />

    <LinearLayout
        android:id="@+id/build_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/build_import"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bb_import_outline"
        android:gravity="center"
        android:text="@string/add_roblox"
        android:textColor="@color/bb_variant"
        android:textSize="14.5sp"
        android:clickable="true"
        android:focusable="true" />


</LinearLayout>
