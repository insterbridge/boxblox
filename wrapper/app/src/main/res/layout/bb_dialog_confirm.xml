<?xml version="1.0" encoding="utf-8"?>
<!--
  Confirmation dialog for a destructive action, matching bb_dialog_notice:
  the same 24dp title/body metrics and the same end-aligned action row as
  bb_dialog_number. Only the two actions differ, because a delete needs a
  neutral escape beside the destructive choice.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bb_dialog_surface"
    android:paddingTop="24dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/bb_on_surface"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/confirm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/bb_variant"
        android:textSize="13.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="24dp"
        android:paddingEnd="14dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/confirm_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/cancel"
            android:textColor="@color/bb_primary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/confirm_action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/bb_error"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
