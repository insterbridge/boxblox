<?xml version="1.0" encoding="utf-8"?>
<!-- Row background. The selected state is applied in code by swapping this for
     bb_build_row_on, the same way flag cards mark themselves. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bb_surface_3" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/bb_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
