<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The hero's radial wash. Android has no radial-gradient drawable, so this is
      a soft vertical gradient toward the primary container — close enough at the
      size it is used, and it keeps the hero from being a flat rectangle.
    -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#2E2350"
                android:centerColor="#1B1726"
                android:endColor="#141218" />
        </shape>
    </item>
</layer-list>
